 "html": "<div class=\"container-fluid\">\n    <div class=\"text-center mb-4\">\n        <h2 class=\"fw-bold mb-1 h1\">Booking Confirmation</h2>\n        {% if doc.print_summary %}\n        <div class=\"text-muted\">\n            {{doc.print_summary}}\n        </div>\n        {% endif %}\n    </div>\n    \n    {% if doc.status == \"Pending Confirmation\" %}\n    <div class=\"alert alert-warning text-center fw-bold mb-4\">\n        Not Yet Confirmed - hold your seat\n    </div>\n    {% endif %}\n    \n    <div class=\"card mb-4\">\n        <div class=\"card-header fw-bold h2\">Member</div>\n        <div class=\"card-body\">\n            <div class=\"row\">\n                <div class=\"col-xs-6 mb-3\">\n                    <div class=\"text-muted small\">Member</div>\n                    <div class=\"fw-semibold\">{{doc.member}}</div>\n                </div>\n                {% set email=frappe.db.get_value(\"Member\",doc.member,\"email\") %}\n                {% if email %}\n                <div class=\"col-xs-6 mb-3\">\n                    <div class=\"text-muted small\">Member Email</div>\n                    <div class=\"fw-semibold\">{{email}}</div>\n                </div>\n                {% endif %}\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"card mb-4\">\n        <div class=\"card-header fw-bold h2\">\n            Resource & Schedule\n        </div>\n        <div class=\"card-body\">\n            <div class=\"row\">\n                <div class=\"col-xs-6 mb-3\">\n                    <div class=\"text-muted\">Resource</div>\n                    <div class=\"fw-semibold\">{{doc.resource}}</div>\n                </div>\n                <div class=\"col-xs-6 mb-3\">\n                    <div class=\"text-muted\">Booking Date</div>\n                    <div class=\"fw-semibold\">{{frappe.format_date(doc.booking_date)}}</div>\n                </div>\n                <div class=\"col-xs-6 mb-3\">\n                    <div class=\"text-muted\">Start Time</div>\n                    <div class=\"fw-semibold\">{{doc.start_time}}</div>\n                </div>\n                <div class=\"col-xs-6 mb-3\">\n                    <div class=\"text-muted\">End Time</div>\n                    <div class=\"fw-semibold\">{{doc.end_time}}</div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"card mb-4\">\n        <div class=\"card-header fw-bold h2\"> Add-ons</div>\n        <div class=\"card-body p-0\">\n            <div class=\"table-responsive\">\n                <table class=\"table table-bordered table-hover mb-0\">\n                    <thead class=\"table-light\">\n                        <tr>\n                            <th>Add-on</th>\n                            <th class=\"text-end\">Qty</th>\n                            <th class=\"text-end\">Rate</th>\n                            <th class=\"text-end\">Amount</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for row in doc.addons %}\n                        <tr>\n                            <td>{{row.service_name}}</td>\n                            <td>{{row.quantity}}</td>\n                            <td>{{frappe.format_value(row.rate,{\"fieldtype\":\"Currency\"})}}</td>\n                            <td>{{frappe.format_value(row.amount,{\"fieldtype\":\"Currency\"})}}</td>\n                        </tr>\n                        {% endfor %}\n                    </tbody>\n                    <tfoot>\n                        <tr class=\"table-light fw-bold\">\n                            <td colspan=\"3\">Add-ons Total</td>\n                            <td>{{frappe.format_value(doc.addons_total,{\"fieldtype\":\"Currency\"})}}</td>\n                        </tr>\n                    </tfoot>\n                </table>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"card mb-4 ms-5\">\n        <div class=\"card-body\">\n            <div class=\"row\">\n                <div class=\"col-6\">\n                    <div class=\"h2 fw-bold mb-2 ms-2\"> Total Amount </div>\n                </div>\n                <div class=\"col-6\">\n                    <div class=\"display-6 fw-bold ms-2\">{{ frappe.format_value(doc.total_amount, \"Currency\") }}</div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"card mb-4\">\n        <div class=\"card-header fw-bold h2\">Booking Summary</div>\n        <div class=\"card-body\">{{doc.print_summary}}</div>\n    </div>\n</div>",
